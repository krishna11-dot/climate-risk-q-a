# Copy this file to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/climate_risk

# LLM gateway (Groq free tier via LiteLLM)
GROQ_API_KEY=your-groq-api-key
LITELLM_API_KEY=your-groq-api-key
LITELLM_CACHE_ENABLED=true
LITELLM_FALLBACK_MODEL=openrouter/qwen/qwen3.6-72b
LITELLM_MAX_RETRIES=3

# Observability
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=climate-risk-agent
# Optional: regional data residency endpoint, e.g. APAC:
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# Governance
AGENT_PAUSED=false

# TODO: set before running rag/ingest.py
UKCP18_PDF_DIR=data/ukcp18_pdfs/

# TODO: set before running analysis_agent against real data
CMIP6_NETCDF_DIR=data/cmip6_netcdf/
CORDEX_NETCDF_DIR=data/cordex_netcdf/
